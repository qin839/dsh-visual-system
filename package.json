{
  "name": "dsh-visual-system",
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "description": "Wallpaper-driven visual system for the DeepSeek Harness Web GUI — one preset.json swaps the whole colour system and background",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js"
  },
  "license": "MIT",
  "author": "qin839",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qin839/dsh-visual-system.git"
  },
  "homepage": "https://github.com/qin839/dsh-visual-system#readme",
  "bugs": {
    "url": "https://github.com/qin839/dsh-visual-system/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "theme",
    "wallpaper"
  ],
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "presets/*/preset.json",
    "presets/demo/assets",
    "test",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
